---
// Scrolling page with the site header and footer. Used by everything except the home page.
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} · Adrien Poly`} description={description}>
  <div class="page">
    <div class="page-glow" aria-hidden="true"></div>

    <header class="page-header">
      <a class="page-home" href="/">Adrien Poly</a>
      <nav aria-label="Main">
        <a class="page-link" href="/articles/">Articles</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="page-footer">
      <a class="page-link" href="https://github.com/adrienpoly" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="page-link" href="https://x.com/adrienpoly" target="_blank" rel="noopener noreferrer">Twitter</a>
      <a class="page-link" href="https://linkedin.com/in/adrienpoly" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="page-link" href="/rss.xml">RSS</a>
    </footer>
  </div>
</Base>

<style>
  .page {
    position: relative;
    max-width: 728px;
    min-height: 100dvh;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  /* Same glow as the home page, pinned to the top of the page. */
  .page-glow {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1280px, 100vw);
    height: 520px;
    transform: translateX(-50%);
    background: radial-gradient(
      900px 420px at 50% 0%,
      color-mix(in srgb, var(--accent) 8%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .page-header,
  main,
  .page-footer {
    position: relative;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 40px 0 72px;
  }

  .page-home {
    position: relative;
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.018em;
    color: var(--text-strong);
    text-decoration: none;
  }

  .page-home::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .page-link {
    padding-bottom: 3px;
    font-size: 14px;
    letter-spacing: 0.01em;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .page-link:hover {
    color: var(--text-strong);
    border-color: var(--accent);
  }

  main {
    flex: 1;
  }

  .page-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 96px;
    padding: 28px 0 48px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 760px) {
    .page {
      padding: 0 20px;
    }

    .page-header {
      padding: 28px 0 48px;
    }

    .page-footer {
      margin-top: 72px;
    }
  }
</style>
