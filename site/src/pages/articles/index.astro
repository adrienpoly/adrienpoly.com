---
import Page from "../../layouts/Page.astro";
import { formatDate, getArticles } from "../../lib/articles";

const articles = await getArticles();
---

<Page title="Articles" description="Articles by Adrien Poly on building products, Ruby and Rails.">
  <h1>Articles</h1>

  {articles.length === 0 && <p class="empty">Nothing published yet.</p>}

  <ul class="article-list">
    {
      articles.map((article) => (
        <li>
          <a href={`/articles/${article.id}/`}>
            <time datetime={article.data.pubDate.toISOString()}>
              {formatDate(article.data.pubDate)}
            </time>
            <div>
              <h2>
                {article.data.title}
                {article.data.draft && <span class="draft">Draft</span>}
              </h2>
              <p>{article.data.description}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Page>

<style>
  h1 {
    margin: 0 0 40px;
    font-size: clamp(32px, 5.2vw, 44px);
    font-weight: 560;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--text-strong);
  }

  .empty {
    color: var(--text-muted);
  }

  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li {
    border-top: 1px solid var(--border);
  }

  .article-list a {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 24px 0;
    text-decoration: none;
  }

  time {
    font-size: 13px;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  h2 {
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--text-strong);
    text-wrap: balance;
    transition: color 0.2s;
  }

  a:hover h2 {
    color: var(--accent);
  }

  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .draft {
    margin-left: 10px;
    padding: 2px 7px;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    vertical-align: 2px;
  }

  @media (max-width: 760px) {
    .article-list a {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 20px 0;
    }
  }
</style>
